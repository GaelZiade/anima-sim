{
  "name": "anima-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador de combate para Anima: Beyond Fantasy con IA heurística y Monte Carlo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sim": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench.mjs --log-level=warning && node node_modules/.cache/bench.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "3.1.2"
  },
  "dependencies": {
    "fflate": "0.8.2"
  }
}
